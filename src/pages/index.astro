---
export const prerender = false;
import {loadCorporatePage} from "../cms/pages";
import HomePage from "../components/HomePage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
const cms=await loadCorporatePage("home","en");
if(!cms)return Astro.rewrite("/404");
---

<SiteLayout
  title={cms.metaTitle}
  description={cms.metaDescription}
  lang="en"
  active="home"
>
  <HomePage lang="en" />
</SiteLayout>
