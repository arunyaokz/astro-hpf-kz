---
export const prerender = false;
import {loadCorporatePage} from "../../cms/pages";
import HomePage from "../../components/HomePage.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import type { Lang } from "../../site-v2";

const lang=Astro.params.lang as Lang;
if(!['zh','ru'].includes(lang))return Astro.rewrite('/404');
const cms=await loadCorporatePage('home',lang);
if(!cms)return Astro.rewrite('/404');
---
<SiteLayout title={cms.metaTitle} description={cms.metaDescription} lang={lang} active="home"><HomePage lang={lang} /></SiteLayout>
