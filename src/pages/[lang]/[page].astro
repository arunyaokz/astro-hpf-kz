---
export const prerender = true;
import PrivacyPage from "../../components/PrivacyPage.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { PRIVACY_COPY, pagePath, type Lang } from "../../site-v2";
export function getStaticPaths() {
  return (["zh", "ru"] as const).flatMap((lang) => (["contact", "privacy"] as const).map((page) => ({ params: { lang, page } })));
}
const lang = Astro.params.lang as Lang;
if (Astro.params.page === "contact") return Astro.redirect(pagePath(lang, "contact"), 301);
const meta = PRIVACY_COPY[lang];
---
<SiteLayout title={meta.metaTitle} description={meta.metaDescription} lang={lang} active="privacy"><PrivacyPage lang={lang} /></SiteLayout>
