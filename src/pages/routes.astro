---
export const prerender = false;
import RouteNetworkPage from "../components/RouteNetworkPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadCorporatePage } from "../cms/pages";
const cms = await loadCorporatePage("routes", "en");
if (!cms) return Astro.rewrite("/404");
const page = cms.page;
---
<SiteLayout title={page.metaTitle} description={page.metaDescription} lang={"en"} active="routes" breadcrumbs={[{ name: "Home", path: "/" }, { name: "Routes & network", path: "/routes/" }]}><RouteNetworkPage lang={"en"} cms={cms} /></SiteLayout>
