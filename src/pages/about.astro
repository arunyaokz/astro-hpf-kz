---
export const prerender = false;
import ContentPage from "../components/ContentPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadCorporatePage } from "../cms/pages";
const cms = await loadCorporatePage("company", "en");
if (!cms) return Astro.rewrite("/404");
const page = cms.page;
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<SiteLayout title={page.metaTitle} description={page.metaDescription} lang={"en"} active="about"><ContentPage lang={"en"} cms={cms} pageKey="about" /></SiteLayout>
