---
import {pagePath, type Lang} from '../site-v2';
import CardVisual from './CardVisual.astro';
const {lang} = Astro.props as {lang: Lang};
const c = {
 zh:{tag:'库雷克港 · 跨里海运输',title:'跨越里海，\n每一步都心中有数。',lead:'围绕库雷克港的排期、装船与跨里海衔接，跟进关键节点，及时沟通变化。',cta:'咨询绿通方案',index:'HPF 库雷克绿通运行指数',unavailable:'数据核验中',wait:'车辆离港记录正在核对，满足发布条件后展示指数和历史走势。',scope:'统计 HPF 经办车辆从订单确认到库雷克实际离港的时长。',explain:'指数到底在说什么？',simple:'它告诉您：最近，我们经办的车辆从订单确认到库雷克离港，比过去选定的一段时间快了还是慢了。',base:'和基准期差不多',up:'比基准期快',down:'比基准期慢',baseText:'我们把选定的过去一段时间定为基准，指数记作 100。',upText:'数字越高，说明近期典型速度比基准期越快。',downText:'数字越低，说明近期典型速度比基准期越慢。',example:'举个例子',exampleText:'假设基准期通常要 10 天，最近通常要 8.5 天，指数约为 118。这个例子只是说明算法，不是实际数据。',boundary:'“通常”指取统计车辆时长的中间值。实际时间受船期、天气、文件和港口安排等影响；指数只反映 HPF 经办车辆，不代表整个港口。',service:'每一个节点，都有安排。',services:[['前置准备','了解车辆和货物情况，核对服务需求及所需资料。'],['港口协调','跟进港口安排与装船窗口，及时沟通变化。'],['节点跟进','关注关键进度，向客户反馈已确认的信息。']],more:'统计口径与说明',question:'指数能保证每辆车的时间吗？',answer:'不能。指数是历史统计，不能作为单票运输时效承诺。',history:'历史走势',baseLabel:'基准期 = 100',period:['3个月','6个月','12个月'],time:'数据截至',vehicles:'统计车辆',days:'近 30 天典型时长',day:'天',observe:'查看运行观察', overview:'库雷克绿通运行观察', indexShort:'绿通运行指数', historyWait:'连续积累有效数据后，展示各统计周期的变化。'},
 en:{tag:'KURYK PORT · TRANS-CASPIAN',title:'Across the Caspian,\nwith clarity at every step.',lead:'We coordinate port arrangements, loading and onward transport, and communicate changes as they happen.',cta:'Discuss your shipment',index:'HPF Kuryk Green Channel Index',unavailable:'Data under review',wait:'Vehicle departure records are being checked. The index and history will appear when the data meets publication requirements.',scope:'Time from order confirmation to actual departure from Kuryk for HPF-handled vehicles.',explain:'What does the index mean?',simple:'It shows whether HPF-handled vehicles recently moved from order confirmation to departure faster or slower than in a selected past period.',base:'Similar to the baseline',up:'Faster than the baseline',down:'Slower than the baseline',baseText:'A selected past period is the baseline, set to 100.',upText:'A higher number means the typical process was faster than the baseline.',downText:'A lower number means the typical process was slower than the baseline.',example:'For example',exampleText:'If the baseline was typically 10 days and the recent figure is 8.5 days, the index is about 118. This is an example, not actual data.',boundary:'Typical means the middle value of vehicle times. Individual times depend on vessel schedules, weather, documents and port arrangements. This covers HPF-handled vehicles, not the entire port.',service:'Every handover has a plan.',services:[['Preparation','Confirm vehicle and cargo details and required documents.'],['Port coordination','Follow port arrangements and loading windows.'],['Progress updates','Follow key milestones and share confirmed information.']],more:'How the index works',question:'Does the index guarantee an individual shipment time?',answer:'No. It describes historical observations, not a delivery promise.',history:'Historical trend',baseLabel:'Baseline = 100',period:['3M','6M','12M'],time:'Data as of',vehicles:'Valid vehicles',days:'Typical time, last 30 days',day:'days',observe:'See operating data',overview:'Kuryk Green Channel overview',indexShort:'Operating index',historyWait:'Historical trends appear when sufficient verified data is available.'},
 ru:{tag:'ПОРТ КУРЫК · ТРАНСКАСПИЙСКИЙ МАРШРУТ',title:'Через Каспий —\nясность на каждом этапе.',lead:'Координируем работу в порту, погрузку и дальнейшую перевозку, сообщаем об изменениях.',cta:'Обсудить перевозку',index:'Индекс зелёного коридора HPF в Курыке',unavailable:'Данные проверяются',wait:'Данные об отправлении автомобилей проверяются. Индекс и история появятся после проверки.',scope:'Время от подтверждения заказа до фактического выхода из порта Курык для автомобилей, обслуженных HPF.',explain:'Что означает индекс?',simple:'Он показывает, быстрее или медленнее автомобили HPF проходят путь от подтверждения заказа до выхода из порта по сравнению с выбранным прошлым периодом.',base:'Примерно как в базовом периоде',up:'Быстрее базового периода',down:'Медленнее базового периода',baseText:'Выбранный прошлый период принят за базу: его индекс равен 100.',upText:'Чем выше число, тем быстрее обычный процесс по сравнению с базой.',downText:'Чем ниже число, тем медленнее обычный процесс по сравнению с базой.',example:'Например',exampleText:'Если в базовом периоде обычно требовалось 10 дней, а недавно — 8,5 дня, индекс составит около 118. Это условный пример.',boundary:'Под обычным временем понимается срединное значение. Срок отдельной машины зависит от рейса, погоды, документов и работы порта. Индекс отражает только автомобили HPF, а не весь порт.',service:'Каждому этапу — свой план.',services:[['Подготовка','Уточняем сведения об автомобиле, грузе и документах.'],['Координация в порту','Следим за организацией в порту и окнами погрузки.'],['Информация о ходе','Отслеживаем этапы и сообщаем подтверждённые сведения.']],more:'Как рассчитывается индекс',question:'Гарантирует ли индекс срок каждой перевозки?',answer:'Нет. Это историческая статистика, а не обещание срока.',history:'Динамика',baseLabel:'База = 100',period:['3 мес.','6 мес.','12 мес.'],time:'Данные на',vehicles:'Автомобили',days:'Обычное время за 30 дней',day:'дней',observe:'Показать данные',overview:'Обзор зелёного коридора',indexShort:'Индекс работы',historyWait:'Динамика появится после накопления проверенных данных.'}
}[lang];
---
<article class="green-page"><section class="green-hero shell"><div><p class="eyebrow">{c.tag}</p><h1>{c.title}</h1><p class="lead">{c.lead}</p><div class="hero-actions"><a class="button button--primary" href={pagePath(lang,'contact')}>{c.cta}</a><a class="text-link green-jump" href="#green-data">{c.observe} ↓</a></div></div><div class="market" data-green-index data-lang={lang}><div class="market-head"><div><small>HPF · KURYK</small><h2>{c.index}</h2></div><span class="market-pill" data-status>{c.unavailable}</span></div><strong class="market-number" data-index>—</strong><p class="market-sub" data-note>{c.wait}</p><div class="chart" aria-label={c.history}><svg viewBox="0 0 500 220" role="img" aria-label={c.history}><defs><linearGradient id="green-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#a18cff" stop-opacity=".4"/><stop offset="1" stop-color="#a18cff" stop-opacity="0"/></linearGradient></defs><g stroke="#b7a6ff" stroke-opacity=".16"><path d="M0 32H500M0 85H500M0 138H500M0 191H500" /></g><path data-baseline fill="none" stroke="#b7a6ff" stroke-opacity=".6" stroke-dasharray="4 5"/><text data-baseline-label x="495" text-anchor="end" fill="#c8c0e2" font-size="10"></text><path data-area fill="url(#green-fill)"/><path data-line fill="none" stroke="#b8aaff" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/><g data-points fill="#d8d0ff"></g></svg><span data-chart-empty>{c.unavailable}</span></div><div class="chart-footer"><span data-chart-start>{c.history}</span><span data-chart-end>{c.baseLabel}</span></div><div class="chart-controls">{c.period.map((x,i)=><button type="button" data-months={[3,6,12][i]} disabled>{x}</button>)}</div></div></section><section class="green-data" id="green-data"><div class="shell"><p class="eyebrow">HPF · KURYK GREEN CHANNEL</p><h2 class="section-title">{c.overview}</h2><p class="green-data-lead" data-summary>{c.scope}</p><div class="green-metrics"><article><small>{c.days}</small><strong data-metric-days>—</strong></article><article><small>{c.indexShort}</small><strong data-metric-index>—</strong></article><article><small>{c.vehicles}</small><strong data-metric-count>—</strong></article></div><p class="green-data-note" data-data-note>{c.wait}</p><div class="green-history"><h3>{c.history}</h3><p data-history-note>{c.historyWait}</p></div></div></section><section class="green-explain shell"><p class="eyebrow">{({zh:"看懂这个数字",en:"Understanding the index",ru:"Как понять индекс"})[lang]}</p><h2 class="section-title">{c.explain}</h2><p class="green-intro">{c.simple}</p><div class="green-grid"><article><b>100</b><h3>{c.base}</h3><p>{c.baseText}</p></article><article><b>&gt; 100</b><h3>{c.up}</h3><p>{c.upText}</p></article><article><b>&lt; 100</b><h3>{c.down}</h3><p>{c.downText}</p></article></div><aside><strong>{c.example}</strong><p>{c.exampleText}</p></aside><p>{c.boundary}</p></section><section class="green-services shell"><p class="eyebrow">{({zh:"绿通服务",en:"Green Channel service",ru:"Услуга зелёного коридора"})[lang]}</p><h2 class="section-title">{c.service}</h2><div class="green-grid">{c.services.map(([title,text],i)=><article><CardVisual kind={["docs-first","responsibility","memory"][i]} /><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section><section class="green-faq shell"><h2 class="section-title">{c.more}</h2>{({zh:[['统计范围是什么？','统计符合条件的 HPF 经办车辆，从订单确认至库雷克实际离港；不代表整个港口的排队情况。'],['指数如何计算？','以固定基准期的典型时长除以近 30 天的典型时长，再乘以 100。'],['为什么有时没有数字？','样本不足、记录过期或核验未通过时会暂停展示。']],en:[['What is included?','Eligible HPF-handled vehicles, from order confirmation to actual departure from Kuryk. It does not represent port-wide queues.'],['How is the index calculated?','Divide the baseline typical time by the recent 30-day typical time, then multiply by 100.'],['Why might no number be shown?','Publication is paused if the sample is insufficient, records are stale or checks fail.']],ru:[['Что входит в расчёт?','Автомобили HPF с подходящими данными: от подтверждения заказа до фактического выхода из Курыка. Индекс не отражает очередь во всём порту.'],['Как рассчитывается индекс?','Обычное время базового периода делится на обычное время последних 30 дней и умножается на 100.'],['Почему данные могут отсутствовать?','Публикация приостанавливается при недостатке выборки, устаревших данных или непрошедшей проверке.']]} as const)[lang].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}<details><summary>{c.question}</summary><p>{c.answer}</p></details><a class="button button--primary" href={pagePath(lang,'contact')}>{c.cta}</a></section></article>
<style>
.green-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(3rem,7vw,7rem);align-items:center;padding-block:clamp(4.5rem,9vw,8rem);width:min(100%,var(--page-max));max-width:var(--page-max);background:#0b071f;color:#fff;position:relative;isolation:isolate}.green-hero:before{content:"";position:absolute;z-index:-1;inset-block:0;left:50%;width:100vw;transform:translateX(-50%);background:#0b071f}.green-hero h1{font-size:clamp(3rem,7vw,6.5rem);font-weight:760;line-height:.98;letter-spacing:-.06em;white-space:pre-line;color:#fff}.green-hero .lead{max-width:35rem;line-height:1.8;margin:1.5rem 0 2rem;color:rgba(224,220,244,.7)}.green-hero .eyebrow{color:#aaa0ff}.hero-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap}.green-jump{color:#c2b7ff}.market{border:1px solid rgba(190,177,255,.16);border-radius:32px 32px 12px 32px;overflow:hidden;background:radial-gradient(ellipse at 60% 40%,#322465,#161133 55%,#0b0b20);color:#f5f3ff;padding:clamp(24px,4vw,50px);min-height:470px;position:relative}.market:before{content:'';position:absolute;inset:0;background-image:linear-gradient(#aaa1ff0b 1px,transparent 1px),linear-gradient(90deg,#aaa1ff0b 1px,transparent 1px);background-size:32px 32px;pointer-events:none}.market>*{position:relative}.market-head{display:flex;justify-content:space-between;gap:1rem}.market-head small{color:#b8addd;letter-spacing:.12em}.market-head h2{color:white;font-size:1.2rem;margin:.6rem 0}.market-pill{height:fit-content;border:1px solid #8b7ccc77;border-radius:2rem;padding:.4rem .7rem;font-size:.7rem}.market-number{display:block;font-size:4rem;line-height:1;margin:2rem 0 .8rem}.market-sub{font-size:.85rem;color:#d1cae3;line-height:1.7}.chart{position:relative;margin-top:2rem}.chart svg{display:block;width:100%}.chart>span[hidden]{display:none}.chart>span{position:absolute;inset:0;display:grid;place-items:center;color:#b2a9c8;font-size:.85rem}.chart-footer{display:flex;justify-content:space-between;color:#b7adc8;font-size:.75rem}.chart-controls{display:flex;gap:.3rem;border-top:1px solid #c1b4f330;margin-top:1rem;padding-top:1rem}.chart-controls button{background:transparent;color:#ddd6ed;border:0;padding:.6rem;cursor:pointer}.chart-controls button:disabled{opacity:.45;cursor:default}.chart-controls button.active{background:#9785ef42}.green-data{background:#f3f2f8;padding:5rem 0}.green-data .section-title{margin:1rem 0}.green-data-lead,.green-data-note,.green-history p{color:#555968;line-height:1.7}.green-metrics{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid #d4d1df;margin:2.2rem 0 1.2rem}.green-metrics article{padding:1.5rem;border-left:1px solid #d4d1df}.green-metrics article:first-child{padding-left:0;border-left:0}.green-metrics small{color:#686579}.green-metrics strong{display:block;font-size:2.4rem;margin-top:.5rem}.green-history{border-top:1px solid #d4d1df;margin-top:2rem;padding-top:1.5rem}.green-history h3{margin-bottom:.5rem}.green-explain,.green-services,.green-faq{padding-block:5rem}.green-intro{font-size:1.25rem;line-height:1.8;max-width:55rem}.green-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#dad7e5;border:1px solid #dad7e5;margin-top:2rem}.green-grid article{background:#f7f6fa;padding:2rem}.green-grid b{font-size:2rem;color:#6352c9}.green-grid article span{color:#6352c9}.green-services :global(.card-visual){width:100%;max-height:125px;margin-bottom:1rem}.green-services :global(.visual-halo){animation:green-glow 4s ease-in-out infinite alternate}.green-services :global(.route),.green-services :global(.rail){stroke-dasharray:7 9;animation:green-flow 20s linear infinite}@keyframes green-glow{from{opacity:.45}to{opacity:1}}@keyframes green-flow{to{stroke-dashoffset:-160}}@media(prefers-reduced-motion:reduce){.green-services :global(.visual-halo),.green-services :global(.route),.green-services :global(.rail){animation:none}}.green-grid p,.green-explain p,.green-faq p{line-height:1.8}.green-explain aside{border-left:3px solid #8675ec;background:#f1eff9;padding:1.5rem;margin:1.5rem 0}.green-explain aside p{margin:.5rem 0 0}.green-faq details{border-block:1px solid #ddd;padding:1.3rem 0;margin:2rem 0}.green-faq summary{cursor:pointer;font-weight:700}@media(max-width:760px){.green-hero{grid-template-columns:1fr;padding-block:4rem;gap:2rem}.green-grid{grid-template-columns:1fr}.green-explain,.green-services,.green-faq{padding-block:3rem}.market{min-height:0}.green-data{padding:3rem 0}.green-metrics{grid-template-columns:1fr}.green-metrics article,.green-metrics article:first-child{padding:1rem 0;border-left:0;border-top:1px solid #d4d1df}.green-metrics article:first-child{border-top:0}}
</style>
<style is:global>body:has(.green-page) .site-header{background:rgba(13,9,40,.96)}</style>

<script src="/green-index.js" is:inline defer></script>
