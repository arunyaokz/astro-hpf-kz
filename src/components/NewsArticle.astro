---
import { getTranslations, type ContentEntry } from "emdash";
import { PortableText, Image as EmDashImage } from "emdash/ui";
import SiteLayout from "../layouts/SiteLayout.astro";
import NewsShare from "./NewsShare.astro";
import { newsPath, newsLabel, sourceUrls, NEWS_COPY, type NewsData } from "../news";
import { LANGS, type Lang } from "../site-v2";
type NewsLang = Lang | "kk";
interface Props { lang: NewsLang; entry: ContentEntry<NewsData>; }
const { lang, entry } = Astro.props;
const { data, edit } = entry;
const text = NEWS_COPY[lang];
const links = sourceUrls(data.source_urls);
// Match only the explicitly labelled final editorial note; ordinary final paragraphs stay unchanged.
const lastBlock = data.content?.at(-1);
const lastChildren = lastBlock && "children" in lastBlock && Array.isArray(lastBlock.children) ? lastBlock.children : [];
const lastText = lastChildren.map((child: { text?: string }) => child.text ?? "").join("").trim();
const hasEditorialNote = /^\*?(?:资料核验截至|Sources checked|Источники проверены|Дереккөздер)/i.test(lastText);
if (hasEditorialNote && lastText.startsWith("*") && lastText.endsWith("*") && lastChildren.length === 1 && typeof lastChildren[0].text === "string") {
  lastChildren[0].text = lastChildren[0].text.replace(/^\*/, "").replace(/\*$/, "");
}
const { translations } = await getTranslations("news", entry.data.id);
const alternates = translations.filter((item) => item.status === "published" && item.slug && (LANGS as readonly string[]).concat("kk").includes(item.locale)).map((item) => ({ lang: item.locale as NewsLang, path: newsPath(item.locale as Lang, item.slug!) }));
const published = data.publishedAt ? new Date(data.publishedAt) : null;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.description,
  mainEntityOfPage: new URL(newsPath(lang, data.slug), Astro.site).toString(),
  inLanguage: lang,
  ...(published && !Number.isNaN(published.getTime()) ? { datePublished: published.toISOString() } : {}),
  ...(data.author_name === "HPF.kz" ? { author: { "@type": "Organization", name: data.author_name } } : {}),
  publisher: { "@type": "Organization", name: "HPF.kz", url: new URL("/", Astro.site).toString() },
};
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<SiteLayout title={`${data.title} | HPF.kz`} description={data.description} lang={lang === "kk" ? "ru" : lang} htmlLang={lang} active="news" canonicalPath={newsPath(lang, data.slug)} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replaceAll("<", "\\u003c")} />
  <article class="article" {...edit}>
    <header class="news-hero">
      <div class="hero-visual" aria-hidden="true">
        {data.hero_image ? <div class="hero-image" {...edit.hero_image}><EmDashImage image={data.hero_image} alt="" /></div> : <img src="/images/corporate/hero-news-20261030.webp" alt="" width="1536" height="1024" />}
        <div class="hero-wash"></div><div class="hero-orbit hero-orbit--one"></div><div class="hero-orbit hero-orbit--two"></div>
      </div>
      <div class="shell hero-content">
        <a class="back" href={newsPath(lang)}>← {text.back}</a>
        <p class="category">{newsLabel(data.category, lang)}</p>
        <h1 {...edit.title}>{data.title}</h1>
        <p class="lead" {...edit.description}>{data.description}</p>
        <p class="meta">{data.author_name ?? "HPF.kz"} · {new Date(data.publishedAt ?? new Date()).toLocaleDateString(lang === "zh" ? "zh-CN" : lang === "ru" ? "ru-RU" : lang === "kk" ? "kk-KZ" : "en-GB", { timeZone: "Asia/Almaty" })} · {text.verification}：{newsLabel(data.verification_status, lang)}</p>
      </div>
    </header>
    <div class="shell article-body">
      <div class:list={["prose", { "has-editorial-note": hasEditorialNote }]}><PortableText value={data.content} /></div>
      <NewsShare lang={lang} title={data.title} description={data.description} url={new URL(newsPath(lang, data.slug), Astro.site).toString()} />
      {links.length > 0 && <footer><h2>{text.sources}</h2><ul>{links.map((url) => <li><a href={url} rel="noreferrer">{url}</a></li>)}</ul></footer>}
    </div>
  </article>
</SiteLayout>
<style>
  .news-hero { position: relative; isolation: isolate; display: grid; align-items: center; min-height: 37rem; overflow: hidden; color: #fff; background: #08051d; }
  .hero-visual, .hero-image, .hero-visual :global(img), .hero-wash { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-visual { z-index: -1; overflow: hidden; }
  .hero-visual :global(img) { object-fit: cover; object-position: center; }
  .hero-wash { background: radial-gradient(circle at 50% 38%, rgba(72,36,190,.12), transparent 32%), linear-gradient(180deg, rgba(7,4,26,.55), rgba(7,4,26,.47) 48%, rgba(7,4,26,.82)); }
  .hero-orbit { position: absolute; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; filter: drop-shadow(0 0 24px rgba(101,89,255,.2)); pointer-events: none; }
  .hero-orbit--one { width: min(74vw,68rem); aspect-ratio: 2.8 / 1; inset: 30% auto auto 50%; transform: translateX(-50%) rotate(-7deg); }
  .hero-orbit--two { width: min(92vw,84rem); aspect-ratio: 3.5 / 1; inset: 38% auto auto 50%; transform: translateX(-50%) rotate(4deg); }
  .hero-content { position: relative; width: 100%; padding-block: 9rem 5rem; }
  .back { display: inline-block; color: #e2dcff; margin-bottom: 2.5rem; }
  .category { color: #d6ceff; font-size: .85rem; margin: 0 0 1.1rem; }
  h1 { color: #fff; max-width: 62rem; margin: 0; font-size: clamp(2.4rem,5vw,4.5rem); line-height: 1.2; overflow-wrap: anywhere; }
  .lead { max-width: 50rem; margin: 1.4rem 0 0; color: rgba(255,255,255,.84); font-size: 1.2rem; line-height: 1.65; }
  .meta { color: rgba(255,255,255,.72); margin: 1.5rem 0 0; font-size: .875rem; line-height: 1.7; }
  .article-body { max-width: 68rem; padding-block: 4rem 6rem; }
  .prose { max-width: 46rem; font-size: 1.1rem; line-height: 1.85; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin-block: 1.25rem; }
  .prose :global(h2), .prose :global(h3) { margin: 2.25rem 0 1rem; }
  .prose :global(img) { height: auto; border-radius: .5rem; }
  .has-editorial-note :global(p:last-child) { font-size: .85rem; line-height: 1.7; color: var(--muted); }
  footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
  footer a { color: var(--violet); }
  @media (max-width: 700px) { .news-hero { min-height: 34rem; } .hero-content { padding-block: 8rem 3.5rem; } .back { margin-bottom: 2rem; } .lead { font-size: 1rem; } .hero-orbit--one { width: 125vw; } .hero-orbit--two { width: 150vw; } .article-body { padding-block: 2.5rem 4rem; } }
</style>
