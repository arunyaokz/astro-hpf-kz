---
import { getTranslations, type ContentEntry } from "emdash";
import { PortableText, Image as EmDashImage } from "emdash/ui";
import SiteLayout from "../layouts/SiteLayout.astro";
import { newsPath, newsLabel, sourceUrls, NEWS_COPY, type NewsData } from "../news";
import { LANGS, type Lang } from "../site-v2";
interface Props { lang: Lang; entry: ContentEntry<NewsData>; }
const { lang, entry } = Astro.props;
const { data } = entry;
const text = NEWS_COPY[lang];
const links = sourceUrls(data.source_urls);
const { translations } = await getTranslations("news", entry.data.id);
const alternates = translations.filter((item) => item.status === "published" && item.slug && LANGS.includes(item.locale as Lang)).map((item) => ({ lang: item.locale as Lang, path: newsPath(item.locale as Lang, item.slug!) }));
Astro.response.headers.set("Cache-Control", "private, no-store");
---
<SiteLayout title={`${data.title} | HPF.kz`} description={data.description} lang={lang} active="news" canonicalPath={newsPath(lang, data.slug)} alternates={alternates}>
  <article class="shell article">
    <header><a class="back" href={newsPath(lang)}>← {text.back}</a><p class="category">{newsLabel(data.category, lang)}</p><h1>{data.title}</h1><p class="lead">{data.description}</p><p class="meta">{data.author_name ?? "HPF.kz"} · {new Date(data.publishedAt ?? new Date()).toLocaleDateString(lang === "zh" ? "zh-CN" : lang === "ru" ? "ru-RU" : "en-GB", { timeZone: "Asia/Almaty" })}</p><p class="meta">{text.verification}：{newsLabel(data.verification_status, lang)}</p></header>
    {data.hero_image && <EmDashImage image={data.hero_image} class="cover" />}
    <div class="prose"><PortableText value={data.content} /></div>
    {links.length > 0 && <footer><h2>{text.sources}</h2><ul>{links.map((url) => <li><a href={url} rel="noreferrer">{url}</a></li>)}</ul></footer>}
  </article>
</SiteLayout>
<style>
  .article{max-width:68rem;padding-block:4rem 6rem}header{display:grid;gap:1.25rem;margin-bottom:3rem}h1{font-size:clamp(2.4rem,5vw,4.5rem)}.lead{font-size:1.2rem}.meta,.category,.lead{color:var(--muted)}.back,a{color:var(--violet)}.prose{max-width:46rem;font-size:1.1rem;line-height:1.85}.prose :global(p),.prose :global(ul),.prose :global(ol){margin-block:1.25rem}.prose :global(h2),.prose :global(h3){margin:2.25rem 0 1rem}.prose :global(img){height:auto;border-radius:.5rem}.article :global(.cover){max-height:34rem;object-fit:cover;margin-bottom:2.5rem}footer{margin-top:3rem;padding-top:2rem;border-top:1px solid var(--line);overflow-wrap:anywhere}
</style>
